# GToTree Web Server frontend — build-time configuration.
#
# Read by Vite at `npm run build`. On AWS Amplify, set these under
# App settings → Environment variables. Locally, copy to `.env.local`.

# Presign Lambda Function URL (the gtotree-presign function — see
# lambda/gtotree_presign.py; same contract as breseq-presign).
#   POST { slug, files:[{name, content_type}] }
#        → { slug, bucket, entries:[{file_name, url, headers:{Content-Type}}] }
#   PUT  <url>  with the returned Content-Type header  (one request per file)
VITE_GTOTREE_API_BASE=https://xxxxxxxx.lambda-url.us-east-2.on.aws

# S3 bucket name where uploads land (display only — the Lambda knows the bucket).
VITE_GTOTREE_INPUT_BUCKET=midauthorbio-gtotree-input

# Public HTTPS URL of the results bucket. The SPA fetches the tree, log, and
# output files directly from here, so it needs public-read + CORS GET.
# Example: https://midauthorbio-gtotree-results.s3.us-east-2.amazonaws.com
VITE_GTOTREE_PUBLIC_RESULTS=https://midauthorbio-gtotree-results.s3.us-east-2.amazonaws.com

# Exact Assembly Grasp HTTPS origin(s), comma-separated; no wildcard.
VITE_ASSEMBLY_GRASP_ORIGINS=

# Dashboard inquiries compose an email; they are not sent automatically.
VITE_DASHBOARD_CONTACT_EMAIL=ark@midauthorbio.com
